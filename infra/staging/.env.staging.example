# RYDO staging settings. Copy to infra/staging/.env (never commit that file) and fill every value.
# Make secrets with:  openssl rand -base64 48

DOMAIN=staging.example.com          # your staging address; DNS A record -> this server, and files.<DOMAIN> too

POSTGRES_USER=rydo
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=rydo
BACKUP_KEEP_DAYS=14

JWT_SECRET=change-me-at-least-32-chars-random
OTP_PEPPER=change-me-at-least-16-chars

# Email (OTP codes, approvals, SOS alerts). Any SMTP provider (Brevo, Amazon SES, Zoho Mail...).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=RYDO <no-reply@example.com>

# Driver documents. Built-in storage below; or point at AWS S3 / Cloudflare R2 instead.
S3_ENDPOINT=https://files.staging.example.com
S3_REGION=ap-south-1
S3_ACCESS_KEY=rydo
S3_SECRET_KEY=change-me-long-random
S3_BUCKET=rydo-documents

# Google Maps: SERVER key (restrict to this server's IP; Places API (New) + Routes API)
GOOGLE_MAPS_API_KEY=
# Google Maps: BROWSER key (restrict to https://<DOMAIN>/*; Maps JavaScript API). Baked into the web build.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=

# First RYDO owner account (seed). Use a strong password; demo company accounts get the same one.
SEED_SUPER_ADMIN_EMAIL=you@thinkvibes.example
SEED_DEV_PASSWORD=change-me-strong-password-1