# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://rydo:rydo@localhost:5432/rydo
WEB_ORIGIN=http://localhost:3000

# Long random strings in production (e.g. openssl rand -base64 48)
JWT_SECRET=dev-only-change-me-dev-only-change-me
OTP_PEPPER=dev-only-pepper-change-me

# Email (local: Mailpit from docker compose, inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="RYDO <no-reply@rydo.local>"

# Object storage, S3 API (local: RustFS from docker compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=rydo
S3_SECRET_KEY=rydo-secret
S3_BUCKET=rydo-documents

# Google Maps server key (Phase 3)
JOBS_ENABLED=true
GOOGLE_MAPS_API_KEY=
# Phone push (Firebase Cloud Messaging). Leave all three empty to run without push; from the Firebase service-account JSON.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Seed: becomes the RYDO Super Admin
SEED_SUPER_ADMIN_EMAIL=admin@rydo.local
# Local-only password the seed gives to demo admin accounts
SEED_DEV_PASSWORD=Rydo@2026
# Several API servers: share live updates through Redis (docker compose up redis)
# REDIS_URL=redis://localhost:6379

# Sign in with Google: the OAuth client id from Google Cloud Console (Credentials > OAuth client ID > Web). Leave empty to switch it off.
# Add http://localhost:3000 (and your real address) under "Authorized JavaScript origins".
GOOGLE_CLIENT_ID=

# Everyone needs a profile photo before using rides (true or false)
REQUIRE_PROFILE_PHOTO=true
# Driver papers checked against government records (Sarathi/Vahan). off = HR checks by eye; demo = made-up answers for local demos (not allowed in production).
DOC_CHECK_PROVIDER=off
