// RYDO Release 1 — database schema (Phase 0 draft)
// Scope: RYDO Share (carpool) for company tenants. Clients: mobile app (riders, drivers) + web app (admins).
// Both clients use the same API and this one PostgreSQL 16 + PostGIS database.
//
// Conventions
// - Every tenant-owned table carries organization_id; the API filters every query by it.
// - UUID primary keys, snake_case tables/columns (@@map / @map), timestamptz everywhere.
// - PostGIS columns are Unsupported(...) in Prisma: read/write them with raw SQL in the repository layer.
// - Partitioning (vehicle_locations) and CHECK constraints are added in raw SQL migrations (see 01-data-model.md).
// - Phase 0 copy: docs/phase-0/schema.prisma. This file is the live one.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pgcrypto, citext]
}

// ───────────────────────── Enums ─────────────────────────

enum OrgStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum Gender {
  FEMALE
  MALE
  OTHER
  UNDISCLOSED
}

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
}

enum MembershipStatus {
  PENDING   // signed up, waiting for HR
  ACTIVE
  REJECTED
  SUSPENDED
  LEFT      // offboarded
}

/// How a person got their account in a company.
enum JoinMethod {
  SELF_SIGNUP   // signed up on their own, then HR approved
  INVITE_LINK   // used an invite link from HR (no approval step)
  ADDED_BY_ADMIN // created by the company or RYDO
}

enum OrgRole {
  ORG_ADMIN
  HR_ADMIN
  OPS_ADMIN
  RIDER
  DRIVER
}

enum ClientType {
  MOBILE
  WEB
}

enum DevicePlatform {
  IOS
  ANDROID
}

enum PlaceLabel {
  HOME
  OFFICE
  OTHER
}

enum DriverStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum ApprovalMode {
  MANUAL      // driver approves each request
  AUTO_TEAM   // auto-accept verified colleagues from own department
}

enum VehicleType {
  CAR
  BIKE
}

enum DocumentKind {
  DRIVING_LICENSE
  VEHICLE_RC
  INSURANCE
  VEHICLE_PHOTO_FRONT   // number plate readable
  VEHICLE_PHOTO_SIDE    // the whole vehicle
  VEHICLE_PHOTO_INSIDE  // seats visible
}

/// The vehicle check comes first: RYDO checks the vehicle and its papers, and only then is the driver sent to HR.
enum VehicleCheckStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum DriverApplicationStatus {
  DRAFT        // still filling it in
  NEEDS_FIXES  // the vehicle check found problems the driver must fix
  WITH_HR      // vehicle verified, waiting for the company HR to approve
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RideDirection {
  TO_OFFICE
  TO_HOME
  OTHER
}

enum RideStatus {
  SCHEDULED    // published, seats open
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StopType {
  PICKUP
  DROP
  WAYPOINT
}

enum RequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum BookingStatus {
  CONFIRMED
  BOARDED
  NO_SHOW
  CANCELLED_BY_RIDER
  CANCELLED_BY_DRIVER
  COMPLETED
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  MATCHED
  EXPIRED
}

enum CommuteDayStatus {
  OFFICE
  WFH
  LEAVE
}

enum RideEventType {
  STARTED
  ARRIVED_AT_PICKUP
  PIN_VERIFIED
  NO_SHOW
  LONG_STOP
  LONG_STOP_OK
  OFF_ROUTE
  COMPLETED
  CANCELLED
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

enum SosStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum IssueCategory {
  IDENTITY_MISMATCH   // the person or vehicle did not match what the app showed
  UNSAFE_DRIVING
  HARASSMENT
  LATE_OR_NO_SHOW
  ROUTE
  COST
  APP_BUG
  OTHER
}

enum IssueStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

// ───────────────────────── Platform & tenancy ─────────────────────────

model Organization {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  slug         String    @unique
  emailDomains String[]  @map("email_domains")      // e.g. {acmetech.com}; sign-up must match one
  logoKey      String?   @map("logo_key")            // object-storage key
  status       OrgStatus @default(PENDING)
  timezone     String    @default("Asia/Kolkata")
  // Ride rules, editable by Org Admin on web. Defaults live in code; see 01-data-model.md
  settings     Json      @default("{}")
  // Set by RYDO (platform owner), never by the client: modules and feature switches. Defaults in @rydo/shared.
  features     Json      @default("{}")
  maxEmployees Int?      @map("max_employees")       // seat limit from the client's plan; null = no limit
  contactName  String?   @map("contact_name")
  contactEmail String?   @map("contact_email")
  contactPhone String?   @map("contact_phone")
  notes        String?                                // internal RYDO notes, never shown to the client
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  offices     Office[]
  departments Department[]
  memberships Membership[]
  licenses    License[]
  supportGrants SupportGrant[]

  @@map("organizations")
}

enum LicenseProduct {
  SHARE       // RYDO Share: carpool between colleagues
  ENTERPRISE  // RYDO Enterprise: company cabs and shuttles
  CAMPUS      // RYDO Campus: school and college buses
}

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

/// What a client is allowed to use. RYDO (super admin) issues, renews, suspends and revokes it. A product works only
/// while its licence is ACTIVE and today is between startsAt and expiresAt (no expiresAt = no end date).
model License {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  product        LicenseProduct
  status         LicenseStatus  @default(ACTIVE)
  startsAt       DateTime       @default(now()) @map("starts_at") @db.Timestamptz
  expiresAt      DateTime?      @map("expires_at") @db.Timestamptz
  notes          String?
  statusReason   String?        @map("status_reason")
  issuedById     String?        @map("issued_by_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, product])
  @@index([expiresAt])
  @@map("licenses")
}

model Office {
  id             String                                @id @default(uuid()) @db.Uuid
  organizationId String                                @map("organization_id") @db.Uuid
  name           String
  address        String
  location       Unsupported("geography(Point,4326)")
  isDefault      Boolean                               @default(false) @map("is_default")
  createdAt      DateTime                              @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([location], type: Gist)
  @@map("offices")
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])
  memberships  Membership[]

  @@unique([organizationId, name])
  @@map("departments")
}

// ───────────────────────── Identity & access ─────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.Citext
  name         String
  phone        String?                                // never shown to other users; masked calls only
  photoKey     String?    @map("photo_key")
  /// Set when the person proved they own this email (email code or Google). Null = not verified yet.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  // { emailUpdates, pushUpdates }: both default to on. Safety and account alerts ignore these.
  notificationPrefs Json @default("{}") @map("notification_prefs")
  gender       Gender     @default(UNDISCLOSED)       // used only for women-only rides
  passwordHash String?    @map("password_hash")       // null = OTP-only sign-in (decision pending)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  platformRoles     PlatformAdmin[]
  memberships       Membership[]
  sessions          Session[]
  deviceTokens      DeviceToken[]
  emergencyContacts EmergencyContact[]
  notifications     Notification[]

  @@map("users")
}

model PlatformAdmin {
  userId    String       @map("user_id") @db.Uuid
  role      PlatformRole
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@id([userId, role])
  @@map("platform_admins")
}

model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @db.Citext
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, createdAt])
  @@map("otp_codes")
}

model Session {
  id               String     @id @default(uuid()) @db.Uuid
  userId           String     @map("user_id") @db.Uuid
  client           ClientType
  refreshTokenHash String     @unique @map("refresh_token_hash")
  userAgent        String?    @map("user_agent")
  expiresAt        DateTime   @map("expires_at") @db.Timestamptz
  revokedAt        DateTime?  @map("revoked_at") @db.Timestamptz
  lastActiveAt     DateTime   @default(now()) @map("last_active_at") @db.Timestamptz // websites end after 2 hours without use
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

model DeviceToken {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  token      String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("device_tokens")
}

// One user × one organization. All org-level data hangs off membership, not user.
model Membership {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  departmentId     String?          @map("department_id") @db.Uuid
  employeeCode     String?          @map("employee_code")
  status           MembershipStatus @default(PENDING)
  joinedVia        JoinMethod       @default(SELF_SIGNUP) @map("joined_via")
  inviteId         String?          @map("invite_id") @db.Uuid
  decidedById      String?          @map("decided_by_id") @db.Uuid   // HR admin membership
  decidedAt        DateTime?        @map("decided_at") @db.Timestamptz
  // Set when RYDO blocks this person in this company; only RYDO can lift it (the company admin cannot reactivate).
  platformBlockedAt   DateTime? @map("platform_blocked_at") @db.Timestamptz
  platformBlockReason String?   @map("platform_block_reason")
  platformBlockedUntil DateTime? @map("platform_blocked_until") @db.Timestamptz // null = until RYDO lifts it
  platformBlockedById String?   @map("platform_blocked_by_id") @db.Uuid
  reliabilityScore Decimal          @default(100) @map("reliability_score") @db.Decimal(5, 2)
  // Rider preferences: { womenOnly, ac, quiet, noSmoking, autoRematch, autoBookCommute, usualToOffice, usualToHome }
  preferences      Json             @default("{}")
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  department   Department?      @relation(fields: [departmentId], references: [id])
  roles        MembershipRole[]
  driver       DriverProfile?
  savedPlaces  SavedPlace[]

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@map("memberships")
}

// Fixed role set in Release 1; permissions are mapped in code (see 02-api.md).
model MembershipRole {
  membershipId String   @map("membership_id") @db.Uuid
  role         OrgRole
  grantedAt    DateTime @default(now()) @map("granted_at") @db.Timestamptz

  membership Membership @relation(fields: [membershipId], references: [id])

  @@id([membershipId, role])
  @@map("membership_roles")
}

model SavedPlace {
  id           String                               @id @default(uuid()) @db.Uuid
  membershipId String                               @map("membership_id") @db.Uuid
  label        PlaceLabel
  name         String
  address      String
  location     Unsupported("geography(Point,4326)")
  isDefault    Boolean                              @default(false) @map("is_default")
  createdAt    DateTime                             @default(now()) @map("created_at") @db.Timestamptz

  membership Membership @relation(fields: [membershipId], references: [id])

  @@index([membershipId])
  @@map("saved_places")
}

model EmergencyContact {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String
  phone     String
  email     String?
  relation  String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("emergency_contacts")
}

model UserBlock {
  organizationId String   @map("organization_id") @db.Uuid
  blockerId      String   @map("blocker_id") @db.Uuid   // membership
  blockedId      String   @map("blocked_id") @db.Uuid   // membership
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([blockerId, blockedId])
  @@index([organizationId])
  @@map("user_blocks")
}

// ───────────────────────── Drivers & verification ─────────────────────────

model DriverProfile {
  id           String       @id @default(uuid()) @db.Uuid
  membershipId String       @unique @map("membership_id") @db.Uuid
  status       DriverStatus @default(PENDING)
  approvalMode ApprovalMode @default(MANUAL) @map("approval_mode")
  // Driver ride preferences: { ac, noSmoking, quiet, musicOk, womenRidersOnly }
  preferences  Json         @default("{}")
  verifiedById String?      @map("verified_by_id") @db.Uuid
  verifiedAt   DateTime?    @map("verified_at") @db.Timestamptz
  // Application: details first, then the vehicle check, then HR.
  applicationStatus DriverApplicationStatus @default(DRAFT) @map("application_status")
  submittedAt       DateTime?               @map("submitted_at") @db.Timestamptz
  dateOfBirth       DateTime?               @map("date_of_birth") @db.Date
  licenseClass      String?                 @map("license_class")
  drivingSince      Int?                    @map("driving_since")
  declaredAt        DateTime?               @map("declared_at") @db.Timestamptz
  guidelinesAcceptedAt DateTime?            @map("guidelines_accepted_at") @db.Timestamptz
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  membership Membership @relation(fields: [membershipId], references: [id])
  vehicles   Vehicle[]
  documents  Document[]

  @@map("driver_profiles")
}

model Vehicle {
  id              String      @id @default(uuid()) @db.Uuid
  organizationId  String      @map("organization_id") @db.Uuid
  driverProfileId String      @map("driver_profile_id") @db.Uuid
  type            VehicleType
  carType         CarType?    @map("car_type")          // Hatchback / Sedan / SUV (cars only)
  make            String
  model           String
  color           String
  plateNumber     String      @map("plate_number")
  seatCapacity    Int         @map("seat_capacity")      // passenger seats only; CHECK 1..6
  hasAc           Boolean     @default(true) @map("has_ac")
  isDefault       Boolean     @default(false) @map("is_default")
  active          Boolean     @default(true)
  manufactureYear Int?        @map("manufacture_year")
  fuelType        String?     @map("fuel_type")
  // The vehicle check: what was looked at, and the result. A vehicle must be VERIFIED before its driver goes to HR.
  checkStatus     VehicleCheckStatus @default(PENDING) @map("check_status")
  checkedAt       DateTime?   @map("checked_at") @db.Timestamptz
  checkResults    Json?       @map("check_results")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz

  driver    DriverProfile @relation(fields: [driverProfileId], references: [id])
  documents Document[]
  rides     Ride[]

  @@unique([organizationId, plateNumber])
  @@map("vehicles")
}

model Document {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  driverProfileId String         @map("driver_profile_id") @db.Uuid
  vehicleId       String?        @map("vehicle_id") @db.Uuid   // set for VEHICLE_RC
  kind            DocumentKind
  storageKey      String         @map("storage_key")           // private bucket; served via short-lived signed URL
  backStorageKey  String?        @map("back_storage_key")      // the back side of a licence or smart-card RC
  number          String?                                       // license / RC number as typed
  expiresAt       DateTime?      @map("expires_at") @db.Date
  status          DocumentStatus @default(PENDING)
  reviewedById    String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?      @map("reviewed_at") @db.Timestamptz
  rejectReason    String?        @map("reject_reason")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  driver  DriverProfile @relation(fields: [driverProfileId], references: [id])
  vehicle Vehicle?      @relation(fields: [vehicleId], references: [id])

  @@index([organizationId, status])
  @@index([expiresAt])
  @@map("documents")
}

// ───────────────────────── Carpool ─────────────────────────

// What the driver publishes once ("every weekday 8:30, return 6:30"). Generates one Ride per date.
model RidePlan {
  id                 String                                     @id @default(uuid()) @db.Uuid
  organizationId     String                                     @map("organization_id") @db.Uuid
  driverMembershipId String                                     @map("driver_membership_id") @db.Uuid
  vehicleId          String                                     @map("vehicle_id") @db.Uuid
  originLabel        String                                     @map("origin_label")
  origin             Unsupported("geography(Point,4326)")
  destinationLabel   String                                     @map("destination_label")
  destination        Unsupported("geography(Point,4326)")
  departTime         DateTime                                   @map("depart_time") @db.Time
  returnTime         DateTime?                                  @map("return_time") @db.Time
  daysOfWeek         Int[]                                      @map("days_of_week")   // 1=Mon … 7=Sun; empty = one-off
  oneOffDate         DateTime?                                  @map("one_off_date") @db.Date
  seats              Int
  womenOnly          Boolean                                    @default(false) @map("women_only")
  notes              String?
  active             Boolean                                    @default(true)
  createdAt          DateTime                                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                                   @updatedAt @map("updated_at") @db.Timestamptz

  rides Ride[]

  @@index([organizationId, active])
  @@map("ride_plans")
}

// One actual run on one date. Live tracking, bookings and chat attach here.
model Ride {
  id                 String                                     @id @default(uuid()) @db.Uuid
  organizationId     String                                     @map("organization_id") @db.Uuid
  ridePlanId         String?                                    @map("ride_plan_id") @db.Uuid
  driverMembershipId String                                     @map("driver_membership_id") @db.Uuid
  vehicleId          String                                     @map("vehicle_id") @db.Uuid
  direction          RideDirection
  originLabel        String                                     @map("origin_label")
  origin             Unsupported("geography(Point,4326)")
  destinationLabel   String                                     @map("destination_label")
  destination        Unsupported("geography(Point,4326)")
  routeLine          Unsupported("geography(LineString,4326)")? @map("route_line")     // from Google Directions
  distanceMeters     Int?                                       @map("distance_meters")
  durationSeconds    Int?                                       @map("duration_seconds")
  departAt           DateTime                                   @map("depart_at") @db.Timestamptz
  seatsTotal         Int                                        @map("seats_total")
  seatsBooked        Int                                        @default(0) @map("seats_booked")   // CHECK seats_booked <= seats_total
  womenOnly          Boolean                                    @default(false) @map("women_only")
  status             RideStatus                                 @default(SCHEDULED)
  startedAt          DateTime?                                  @map("started_at") @db.Timestamptz
  completedAt        DateTime?                                  @map("completed_at") @db.Timestamptz
  cancelledAt        DateTime?                                  @map("cancelled_at") @db.Timestamptz
  cancelReason       String?                                    @map("cancel_reason")
  createdAt          DateTime                                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                                   @updatedAt @map("updated_at") @db.Timestamptz

  plan     RidePlan?     @relation(fields: [ridePlanId], references: [id])
  vehicle  Vehicle       @relation(fields: [vehicleId], references: [id])
  stops    RideStop[]
  requests RideRequest[]
  bookings Booking[]
  events   RideEvent[]
  messages Message[]
  ratings  Rating[]

  @@unique([ridePlanId, departAt])
  @@index([organizationId, departAt, status])
  @@index([driverMembershipId, departAt])
  @@index([routeLine], type: Gist)
  @@index([origin], type: Gist)
  @@map("rides")
}

model RideStop {
  id         String                               @id @default(uuid()) @db.Uuid
  rideId     String                               @map("ride_id") @db.Uuid
  seq        Int
  type       StopType
  bookingId  String?                              @map("booking_id") @db.Uuid
  label      String
  location   Unsupported("geography(Point,4326)")
  plannedAt  DateTime?                            @map("planned_at") @db.Timestamptz
  arrivedAt  DateTime?                            @map("arrived_at") @db.Timestamptz

  ride Ride @relation(fields: [rideId], references: [id])

  @@unique([rideId, seq])
  @@map("ride_stops")
}

model RideRequest {
  id                String                               @id @default(uuid()) @db.Uuid
  organizationId    String                               @map("organization_id") @db.Uuid
  rideId            String                               @map("ride_id") @db.Uuid
  riderMembershipId String                               @map("rider_membership_id") @db.Uuid
  seats             Int                                  @default(1)
  pickupLabel       String                               @map("pickup_label")
  pickup            Unsupported("geography(Point,4326)")
  dropLabel         String                               @map("drop_label")
  drop              Unsupported("geography(Point,4326)")
  matchScore        Int?                                 @map("match_score")       // 0-100 at request time
  matchReasons      Json?                                @map("match_reasons")
  autoRematch       Boolean                              @default(true) @map("auto_rematch")
  status            RequestStatus                        @default(PENDING)
  expiresAt         DateTime                             @map("expires_at") @db.Timestamptz
  decidedAt         DateTime?                            @map("decided_at") @db.Timestamptz
  createdAt         DateTime                             @default(now()) @map("created_at") @db.Timestamptz

  ride    Ride     @relation(fields: [rideId], references: [id])
  booking Booking?

  // Partial unique index (raw SQL): one PENDING request per (ride_id, rider_membership_id)
  @@index([rideId, status])
  @@index([riderMembershipId, status])
  @@map("ride_requests")
}

model Booking {
  id                String                               @id @default(uuid()) @db.Uuid
  organizationId    String                               @map("organization_id") @db.Uuid
  rideId            String                               @map("ride_id") @db.Uuid
  requestId         String                               @unique @map("request_id") @db.Uuid
  riderMembershipId String                               @map("rider_membership_id") @db.Uuid
  seats             Int                                  @default(1)
  pickupLabel       String                               @map("pickup_label")
  pickup            Unsupported("geography(Point,4326)")
  dropLabel         String                               @map("drop_label")
  drop              Unsupported("geography(Point,4326)")
  pin               String                               @db.Char(4)                       // shown only to this rider
  status            BookingStatus                        @default(CONFIRMED)
  boardedAt         DateTime?                            @map("boarded_at") @db.Timestamptz
  cancelledAt       DateTime?                            @map("cancelled_at") @db.Timestamptz
  lateCancel        Boolean                              @default(false) @map("late_cancel")   // inside the free-cancel window
  costShareEst      Decimal?                             @map("cost_share_est") @db.Decimal(10, 2) // estimate only in Release 1
  createdAt         DateTime                             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                             @updatedAt @map("updated_at") @db.Timestamptz

  ride    Ride        @relation(fields: [rideId], references: [id])
  request RideRequest @relation(fields: [requestId], references: [id])

  @@unique([rideId, riderMembershipId])
  @@index([riderMembershipId, status])
  @@map("bookings")
}

model WaitlistEntry {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  riderMembershipId String         @map("rider_membership_id") @db.Uuid
  // { pickup:{lat,lng,label}, drop:{...}, date, fromTime, toTime, seats, filters }
  criteria          Json
  status            WaitlistStatus @default(WAITING)
  notifiedAt        DateTime?      @map("notified_at") @db.Timestamptz
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, status])
  @@map("waitlist_entries")
}

model Rating {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  rideId           String   @map("ride_id") @db.Uuid
  raterMembershipId String  @map("rater_membership_id") @db.Uuid
  rateeMembershipId String  @map("ratee_membership_id") @db.Uuid
  stars            Int                                   // CHECK 1..5
  tags             String[]
  comment          String?  @db.VarChar(280)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  ride Ride @relation(fields: [rideId], references: [id])

  @@unique([rideId, raterMembershipId, rateeMembershipId])
  @@index([rateeMembershipId])
  @@map("ratings")
}

model PreferredDriver {
  riderMembershipId  String   @map("rider_membership_id") @db.Uuid
  driverMembershipId String   @map("driver_membership_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([riderMembershipId, driverMembershipId])
  @@map("preferred_drivers")
}

// Weekly commute planner: one row per member per date.
model CommuteDay {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  membershipId      String           @map("membership_id") @db.Uuid
  date              DateTime         @db.Date
  status            CommuteDayStatus @default(OFFICE)
  toOfficeTime      DateTime?        @map("to_office_time") @db.Time
  toHomeTime        DateTime?        @map("to_home_time") @db.Time
  autoBook          Boolean          @default(true) @map("auto_book")
  toOfficeBookingId String?          @map("to_office_booking_id") @db.Uuid
  toHomeBookingId   String?          @map("to_home_booking_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([membershipId, date])
  @@index([organizationId, date])
  @@map("commute_days")
}

// ───────────────────────── Tracking ─────────────────────────

// Partitioned by day in raw SQL (PARTITION BY RANGE (recorded_at)); old partitions dropped after retention.
model VehicleLocation {
  id         BigInt                               @default(autoincrement())
  rideId     String                               @map("ride_id") @db.Uuid
  recordedAt DateTime                             @map("recorded_at") @db.Timestamptz
  location   Unsupported("geography(Point,4326)")
  accuracyM  Float?                               @map("accuracy_m")
  speedMps   Float?                               @map("speed_mps")
  heading    Float?

  @@id([id, recordedAt])
  @@index([rideId, recordedAt])
  @@map("vehicle_locations")
}

model RideEvent {
  id        String        @id @default(uuid()) @db.Uuid
  rideId    String        @map("ride_id") @db.Uuid
  bookingId String?       @map("booking_id") @db.Uuid
  type      RideEventType
  data      Json?
  at        DateTime      @default(now()) @db.Timestamptz

  ride Ride @relation(fields: [rideId], references: [id])

  @@index([rideId, at])
  @@map("ride_events")
}

// ───────────────────────── Communication & safety ─────────────────────────

model Message {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  rideId             String    @map("ride_id") @db.Uuid
  senderMembershipId String    @map("sender_membership_id") @db.Uuid
  /// The rider this one-to-one chat is with (the other person is the ride's driver).
  riderMembershipId  String    @map("rider_membership_id") @db.Uuid
  body               String    @db.VarChar(1000)
  readAt             DateTime? @map("read_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  ride Ride @relation(fields: [rideId], references: [id])

  @@index([rideId, riderMembershipId, createdAt])
  @@map("messages")
}

model Notification {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  organizationId String?             @map("organization_id") @db.Uuid
  type           String                                       // e.g. REQUEST_RECEIVED, REQUEST_ACCEPTED, SOS_RAISED
  title          String
  body           String
  data           Json?
  channel        NotificationChannel @default(IN_APP)
  readAt         DateTime?           @map("read_at") @db.Timestamptz
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model SosEvent {
  id                   String                                @id @default(uuid()) @db.Uuid
  organizationId       String                                @map("organization_id") @db.Uuid
  rideId               String                                @map("ride_id") @db.Uuid
  raisedByMembershipId String                                @map("raised_by_membership_id") @db.Uuid
  location             Unsupported("geography(Point,4326)")?
  status               SosStatus                             @default(ACTIVE)
  acknowledgedById     String?                               @map("acknowledged_by_id") @db.Uuid
  acknowledgedAt       DateTime?                             @map("acknowledged_at") @db.Timestamptz
  resolvedById         String?                               @map("resolved_by_id") @db.Uuid
  resolvedAt           DateTime?                             @map("resolved_at") @db.Timestamptz
  notes                String?
  createdAt            DateTime                              @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, status])
  @@map("sos_events")
}

model IssueReport {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  reporterMembershipId  String        @map("reporter_membership_id") @db.Uuid
  rideId                String?       @map("ride_id") @db.Uuid
  againstMembershipId   String?       @map("against_membership_id") @db.Uuid
  category              IssueCategory
  description           String
  status                IssueStatus   @default(OPEN)
  assignedToId          String?       @map("assigned_to_id") @db.Uuid
  resolution            String?
  resolvedAt            DateTime?     @map("resolved_at") @db.Timestamptz
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([organizationId, status])
  @@map("issue_reports")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  organizationId String?  @map("organization_id") @db.Uuid    // null = platform action
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  action         String                                         // e.g. MEMBERSHIP_APPROVED, DRIVER_VERIFIED, SOS_RESOLVED
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}


/// Time-boxed, read-only access for RYDO support to one client's admin screens. Every grant is audited.
model SupportGrant {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  reason         String
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz
  endedAt        DateTime? @map("ended_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([userId, organizationId, expiresAt])
  @@map("support_grants")
}

/// Daily count of paid vendor calls (e.g. Google Maps) for the platform health page. Day is India date.
model UsageDaily {
  day      DateTime @db.Date
  provider String
  sku      String
  count    Int      @default(0)

  @@id([day, provider, sku])
  @@map("usage_daily")
}

/// Read-only live trip link a rider shares with family. Only a hash of the token is stored.
model TripShare {
  id        String   @id @default(uuid()) @db.Uuid
  rideId    String   @map("ride_id") @db.Uuid
  bookingId String   @map("booking_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([rideId])
  @@map("trip_shares")
}

enum CarType {
  HATCHBACK
  SEDAN
  SUV
}

enum FeedbackCategory {
  USABILITY      // app usability and interface
  MATCHING       // ride matching and suggestion accuracy
  COMMUNICATION  // chat and notifications
  COST_SHARING   // cost-sharing information (no payments yet)
  GENERAL        // general comments / feature suggestions
}

enum FeedbackStatus {
  NEW
  REVIEWED
  CLOSED
}

enum SurveyStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

/// Always-available feedback form (separate from issue reports and ride ratings).
model Feedback {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  membershipId   String           @map("membership_id") @db.Uuid
  category       FeedbackCategory
  rating         Int?                                   // optional 1..5 satisfaction
  comment        String           @db.VarChar(1000)
  status         FeedbackStatus   @default(NEW)
  adminNote      String?          @map("admin_note")
  reviewedById   String?          @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?        @map("reviewed_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, status, createdAt])
  @@map("feedback")
}

/// Admin-pushed survey. questions: [{ id, type: RATING|CHOICE|TEXT, text, options? }]; audience: { roles?, departmentIds? }.
model Survey {
  id                    String       @id @default(uuid()) @db.Uuid
  organizationId        String       @map("organization_id") @db.Uuid
  createdByMembershipId String       @map("created_by_membership_id") @db.Uuid
  title                 String
  description           String?
  questions             Json
  audience              Json         @default("{}")
  status                SurveyStatus @default(DRAFT)
  publishedAt           DateTime?    @map("published_at") @db.Timestamptz
  closesAt              DateTime?    @map("closes_at") @db.Timestamptz
  audienceSize          Int          @default(0) @map("audience_size")   // people notified at publish; response rate = responses / this
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  responses SurveyResponse[]

  @@index([organizationId, status])
  @@map("surveys")
}

model SurveyResponse {
  id           String   @id @default(uuid()) @db.Uuid
  surveyId     String   @map("survey_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  answers      Json
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz

  survey Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, membershipId])
  @@map("survey_responses")
}

enum InquiryStatus {
  NEW
  CONTACTED
  ONBOARDED
  CLOSED
}

/// A company asking RYDO to be set up, from the public Contact us form. Read and worked by RYDO staff only.
model OnboardingInquiry {
  id          String        @id @default(uuid()) @db.Uuid
  companyName String        @map("company_name")
  contactName String        @map("contact_name")
  workEmail   String        @map("work_email") @db.Citext
  phone       String?
  companySize String        @map("company_size")
  city        String?
  message     String?       @db.VarChar(1500)
  status      InquiryStatus @default(NEW)
  notes       String?
  handledById String?       @map("handled_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, createdAt])
  @@index([workEmail, createdAt])
  @@map("onboarding_inquiries")
}

/// What a new employee told us when they signed up, shown to their company's HR when they decide.
/// Only the last 4 digits of the Aadhaar number are kept; the full number is never sent to the server.
model EmployeeRegistration {
  id            String   @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  membershipId  String   @unique @map("membership_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  fullName      String   @map("full_name")
  phone         String
  /// Which ID proof the person used: AADHAAR, PAN, PASSPORT, DRIVING_LICENCE or VOTER_ID.
  idType        String   @default("AADHAAR") @map("id_type")
  /// Last 4 characters of that ID's number. The full number is never sent or kept.
  idLast4       String   @map("id_last4") @db.VarChar(4)
  employeeId    String   @map("employee_id")
  designation   String
  department    String
  office        String
  managerName   String   @map("manager_name")
  managerEmail  String   @map("manager_email") @db.Citext
  notifiedAt    DateTime? @map("notified_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([organizationId])
  @@map("employee_registrations")
}

/// A link HR shares so employees can create their own account without waiting for approval. Only the hash of the secret is kept. Ends after 24 hours.
model OrgInvite {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash")
  createdByMembershipId String  @map("created_by_membership_id") @db.Uuid
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz
  maxUses             Int       @default(100) @map("max_uses")
  usedCount           Int       @default(0) @map("used_count")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([organizationId, createdAt])
  @@map("org_invites")
}
