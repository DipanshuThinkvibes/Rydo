# Used by automated tests (local and CI). Dummy values only.
NODE_ENV=test
PORT=4000
DATABASE_URL=postgresql://rydo:rydo@localhost:5432/rydo_test
WEB_ORIGIN=http://localhost:3000

# Long random strings in production (e.g. openssl rand -base64 48)
JWT_SECRET=dev-only-change-me-dev-only-change-me
OTP_PEPPER=dev-only-pepper-change-me

# Email (local: Mailpit from docker compose, inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="RYDO <no-reply@rydo.local>"

# Object storage, S3 API (local: RustFS from docker compose)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_ACCESS_KEY=rydo
S3_SECRET_KEY=rydo-secret
S3_BUCKET=rydo-documents

# Google Maps server key (Phase 3)
JOBS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Seed: becomes the RYDO Super Admin
SEED_SUPER_ADMIN_EMAIL=admin@rydo.local
