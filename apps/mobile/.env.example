# Where the app reaches the RYDO API.
# Leave this on localhost: a real phone automatically uses the dev machine's LAN IP
# from Expo. Set an explicit URL (e.g. http://192.168.1.20:4000) only to override it.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google Maps for development / store builds (Expo Go on Android works without them).
# Keys restricted to package com.thinkvibes.rydo. Ask Karan privately; never commit them.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=

# "Continue with Google": OAuth client ids from Google Cloud (public ids, not secrets).
# Put the same ids in services/api/.env GOOGLE_OAUTH_CLIENT_IDS. Empty = the Google button is hidden.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
