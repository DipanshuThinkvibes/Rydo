{
  "expo": {
    "name": "RYDO",
    "slug": "rydo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rydo",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.thinkvibes.rydo"
    },
    "android": {
      "package": "com.thinkvibes.rydo",
      "adaptiveIcon": {
        "backgroundColor": "#0B1426",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1426",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "RYDO uses your photos only when you upload your driving license or vehicle RC.",
          "cameraPermission": "RYDO uses the camera only to photograph your driving license or vehicle RC."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RYDO shows where you are on the map, uses it as your pickup, and shares your car's position with your riders while you drive."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
