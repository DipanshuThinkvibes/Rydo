# Where the RYDO API runs. The web app proxies /api/v1 to it.
API_URL=http://localhost:4000
# Live tracking (Socket.IO). Leave unset in development (uses :4000). Empty = same address as the web.
# NEXT_PUBLIC_REALTIME_URL=
# Optional Google Maps map style id (falls back to DEMO_MAP_ID)
# NEXT_PUBLIC_GOOGLE_MAP_ID=

# Google Maps BROWSER key (Maps JavaScript API). Ask Karan privately; never commit it.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Public site address (used in share previews and the sitemap) and the email shown on the Contact us page.
# NEXT_PUBLIC_SITE_URL=https://rydo.example.com
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Sign in with Google: the SAME OAuth client id as GOOGLE_CLIENT_ID in services/api/.env. Not secret. Leave empty to show the button as "not set up yet".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
